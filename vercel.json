{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": ".*shop.*" }],
      "destination": "/shop.html"
    },
    { "source": "/thankyou", "destination": "/webinar-thank-you" },
    { "source": "/thank-you", "destination": "/webinar-thank-you" }
  ]
}
